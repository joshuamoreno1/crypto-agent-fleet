#!/usr/bin/env zsh
# Instala el heartbeat de Money Agents via launchd (nativo macOS)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLIST="$HOME/Library/LaunchAgents/com.example.money-agents-heartbeat.plist"
TARGET="/usr/local/bin/money-agents-heartbeat"

if [[ ! -f "$PLIST" ]]; then
  echo "❌ No encontré $PLIST"
  echo "Crea el plist primero. Ver README."
  exit 1
fi

# Copiar script al path global (symlink no funciona por TCC de macOS — ~/Documents es protegido para launchd)
echo "📋 Copiando heartbeat.sh → $TARGET"
sudo cp "$SCRIPT_DIR/heartbeat.sh" "$TARGET"
sudo chmod +x "$TARGET"

# Descargar si ya estaba cargado
launchctl unload "$PLIST" 2>/dev/null

# Cargar
launchctl load "$PLIST"

echo "✅ Heartbeat instalado (launchd). Corre cada 30 minutos."
echo ""
echo "Verificar: launchctl list | grep money-agents"
echo "Logs: tail -f /tmp/money-agents-heartbeat.log"
echo "Desinstalar: maho"

#!/usr/bin/env zsh
# Heartbeat para Money Agents Fleet
# Inyecta un prompt al Overseer via Telegram cada 30 minutos
# Instalación: launchd (ver install-heartbeat.sh)

HOUR=$(date +%H)
MINUTE=$(date +%M)
DAY_OF_WEEK=$(date +%u)  # 1=Mon, 7=Sun

# Determinar tipo de heartbeat según la hora
if [[ $HOUR -eq 8 && $MINUTE -lt 30 ]]; then
  # Morning briefing (primera del día)
  PROMPT="HEARTBEAT MATUTINO: Buenos días. Ejecuta el siguiente checklist:
1. Lee data/memory/ para contexto del día anterior
2. Portfolio scan completo (balances + precios actuales + P&L)
3. Revisa yields actuales en Aave/Compound — ¿APY > 2%?
4. Pide al Analyst un scan de señales técnicas en ETH
5. Pide al Analyst un scan de arbitraje entre DEXs
6. Polymarket: revisa posiciones abiertas, P&L, y mercados que estén por resolver
7. Polymarket: scan de mercados trending en crypto/tech con edge >20%
8. Reporta todo to owner via Telegram con resumen ejecutivo"

elif [[ $HOUR -eq 20 && $MINUTE -lt 30 ]]; then
  # Daily P&L report (cierre del día)
  PROMPT="HEARTBEAT CIERRE DIARIO: Genera el reporte de P&L del día:
1. Portfolio scan completo
2. Resumen de trades ejecutados hoy (de data/audit-log/)
3. P&L por estrategia (incluir Polymarket)
4. Win rate actualizado
5. Polymarket: estado de posiciones abiertas, mercados que resolvieron hoy
6. Cualquier lección aprendida → escribir en data/memory/lessons.md
7. Enviar reporte completo to owner via Telegram"

elif [[ $DAY_OF_WEEK -eq 7 && $HOUR -eq 10 && $MINUTE -lt 30 ]]; then
  # Weekly review (domingos 10am)
  PROMPT="HEARTBEAT SEMANAL: Es domingo. Ejecuta el skill weekly-review:
1. Agrega performance semanal
2. Revisa allocation actual vs targets de policy.json
3. Identifica la mejor y peor estrategia de la semana (incluir Polymarket)
4. Polymarket: review de posiciones — ¿alguna para cerrar/ajustar?
5. Polymarket: nuevas oportunidades de la semana con edge >20%
6. Ajusta parámetros si es necesario
7. Envía reporte semanal completo to owner via Telegram"

else
  # Heartbeat regular (cada 30 min durante horario activo)
  PROMPT="HEARTBEAT: Checklist rápido:
1. ¿Hay señales técnicas nuevas? Pide al Analyst un scan rápido
2. ¿Hay oportunidades de arbitraje? Pide al Analyst un scan
3. ¿Alguna posición de yield necesita atención?
4. Polymarket: ¿mercados nuevos con edge >20% en crypto/tech?
5. Polymarket: ¿alguna posición abierta cerca de resolución?
6. Si hay algo actionable → evalúa con risk-checker → ejecuta si aprobado
7. Si hay algo importante → reporta to owner via Telegram
8. Si no hay nada → no reportes (silencio = todo OK)"
fi

# Enviar via Telegram Bot API
curl -s -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
  -d chat_id="${CHAT_ID}" \
  -d text="${PROMPT}" > /dev/null

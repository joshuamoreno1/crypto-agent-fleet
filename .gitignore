# Node modules
mcp-servers/*/node_modules/
node_modules/

# OS
.DS_Store

# Keep empty dirs
!data/audit-log/.gitkeep
!data/market-data/.gitkeep
!data/pending-txs/.gitkeep
!keystore/.gitkeep
